      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (rate(recoil_feed_requests_total{outcome=\"ok\"}[1m]))",
          "legendFormat": "{{variant}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
